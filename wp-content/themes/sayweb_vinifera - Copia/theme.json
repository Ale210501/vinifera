{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "base-2", "name": "Base 2", "color": "#f3efde" },
        { "slug": "contrast", "name": "Contrast", "color": "#1f1f1f" },
        { "slug": "contrast-2", "name": "Contrast 2", "color": "#7a7568" },
        { "slug": "primary", "name": "Primary", "color": "#5e293b" },
        { "slug": "primary-dark", "name": "Primary Dark", "color": "#3d1a26" },
        { "slug": "accent", "name": "Accent", "color": "#354c04" }
      ]
    },
    "spacing": {
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0px"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header",                   "title": "Header",                    "area": "header" },
    { "name": "footer",                   "title": "Footer",                    "area": "footer" },
